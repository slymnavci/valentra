# Valentra

# --- PHP2Shell (CVE-2026-109618 / CVE-2026-109619) gecici onlemleri --
#
# Asil cozum sunucudaki PHP'nin yamali surume gecmesi; bunlar yalnizca
# riski azaltiyor.
#
# 1) Iki acigin da bilinen giris yolu multipart (dosya yuklemeli) POST
#    istegi; PHP govdeyi sayfa kodu calismadan, giris denetiminden once
#    ayristiriyor. Bu yuzden istisna yok: butun multipart istekler PHP'ye
#    hic ulasmadan 403 ile geri cevriliyor. Bedeli, PHP guncellenene
#    kadar panelden kanun PDF'i (admin/kanunlar.php) ve egitim
#    bolumune dosya (egitim/api/dosya_yukle.php) yuklenememesi.
#    PHP yamali surume gecince bu blok kaldirilmali. api/.htaccess
#    kendi RewriteEngine'ini actigi icin kurali miras almiyor; ayni kural
#    orada da var.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Content-Type} multipart/ [NC]
    RewriteRule ^ - [F]
</IfModule>

# 2) Yukleme ilerlemesi kapali. PHP "Apache modulu" olarak calisiyorsa
#    .user.ini okunmaz, ayar buradan verilir. IfModule sart: PHP
#    FPM/FastCGI ile calisiyorsa php_flag bilinmeyen yonerge olur ve tum
#    siteyi 500 ile dusururdu.
<IfModule mod_php.c>
    php_flag session.upload_progress.enabled off
</IfModule>
<IfModule mod_php7.c>
    php_flag session.upload_progress.enabled off
</IfModule>

# IfModule sarmalayicisi sart: mod_rewrite yoksa yonergeler sunucuyu
# 500 ile dusurur ve TUM site erisilemez olur. Paylasimli hostingde
# bunu onceden denemek mumkun degil, o yuzden en temkinli hali.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Site haritasi PHP ile uretiliyor; bu kural yalnizca kolaylik
    # icin, /sitemap.xml adresini de calisir kiliyor. Hicbir sey buna
    # bagli degil: robots.txt dogrudan /sitemap.php adresini bildiriyor,
    # cunku arama motorlari harita adresinde .xml uzantisi sart
    # kosmuyor.
    # --- Tek adres: https://valentra.com.tr (26.10.2026) ----------------
    #
    # Google'dan neredeyse hic ziyaretci gelmiyordu ve ayni sayfa http://,
    # https://, www. ile dort ayri adreste aciliyordu. Search Console'da
    # kayitli adres https://valentra.com.tr; digerleri kalici yonleniyor.
    #
    # /api/ disarida: ajan POST istekleri gonderiyor ve yonlendirmeyi
    # izlemiyor; VALENTRA_SITE_URL http:// ya da www. ile girilmisse
    # ajan bozulmasin.
    #
    # HTTPS uc yoldan taniniyor (sunucu degiskeni, vekil sunucu basligi,
    # 443 portu): vekil arkasinda HTTPS degiskeni bos gelirse sonsuz
    # yonlendirme olmasin.
    RewriteCond %{HTTP_HOST} ^www\.valentra\.com\.tr(:\d+)?$ [NC]
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteRule ^ https://valentra.com.tr%{REQUEST_URI} [R=301,L]

    RewriteCond %{HTTP_HOST} ^valentra\.com\.tr(:\d+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{SERVER_PORT} !=443
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteRule ^ https://valentra.com.tr%{REQUEST_URI} [R=301,L]

    RewriteRule ^sitemap\.xml$ /sitemap.php [L]

    # AdSense yetkili satici dosyasi (29.10.2026; bkz. ads-txt.php).
    RewriteRule ^ads\.txt$ ads-txt.php [L]

    # IndexNow anahtar dosyasi: Bing/Yandex anahtari /<anahtar>.txt
    # adresinde bir metin dosyasi olarak bekliyor; .php adresi
    # "anahtar dogrulanamadi" (403) ile reddedildi. Dosya diskte yok,
    # anahtar ayarlardan okunuyor (bkz. includes/arama_bildirim.php).
    RewriteRule ^([a-f0-9]{32})\.txt$ /indexnow-anahtar.php?k=$1 [L]

    # --- Eski adresler -> temiz adres (kalici yonlendirme) ------------
    #
    # Ayni icerigin iki adresten servis edilmesi arama motorunda
    # bolunmeye yol acar. Eski baglantilar (paylasilmis, yer imine
    # eklenmis, indekslenmis) kirilmasin diye silinmiyor; 301 ile yeni
    # adrese tasiniyor, boylece birikmis deger de yeni adrese geciyor.
    #
    # Kosul THE_REQUEST uzerinden kuruluyor, REQUEST_URI uzerinden
    # degil: asagidaki ic yonlendirmeler REQUEST_URI'yi degistirir ve
    # kural kendi ciktisini yeniden yakalayip sonsuz donguye girerdi.
    # THE_REQUEST ise istemcinin gonderdigi ham istek satiri; ic
    # yonlendirmeyle degismez.
    #
    # Adres satirin basinda araniyor (\s/haber\.php), yani /admin/ ya da
    # baska bir dizin altindaki ayni adli dosyalar etkilenmiyor.

    RewriteCond %{THE_REQUEST} \s/haber\.php\?h=([^\s&]+) [NC]
    RewriteRule ^ /haber/%1? [R=301,L]

    # Sayfa numarasi korunuyor: yalnizca kategoriye dusurmek
    # ziyaretciyi baktigi yerden koparirdi.
    RewriteCond %{THE_REQUEST} \s/kategori\.php\?k=([^\s&]+)&sayfa=([0-9]+) [NC]
    RewriteRule ^ /kategori/%1?sayfa=%2 [R=301,L]

    RewriteCond %{THE_REQUEST} \s/kategori\.php\?k=([^\s&]+) [NC]
    RewriteRule ^ /kategori/%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/kanun\.php\?k=([^\s&]+)&tani=1 [NC]
    RewriteRule ^ /kanun/%1?tani=1 [R=301,L]

    RewriteCond %{THE_REQUEST} \s/kanun\.php\?k=([^\s&]+) [NC]
    RewriteRule ^ /kanun/%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/kanunlar\.php[\s?] [NC]
    RewriteRule ^ /kanunlar? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/pratik-bilgi\.php\?p=([^\s&]+) [NC]
    RewriteRule ^ /pratik/%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/pratik-bilgiler\.php[\s?] [NC]
    RewriteRule ^ /pratik-bilgiler? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/vergi-takvimi\.php[\s?] [NC]
    RewriteRule ^ /vergi-takvimi? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/resmi-gazete\.php\?tarih=([0-9]{4}-[0-9]{2}-[0-9]{2}) [NC]
    RewriteRule ^ /resmi-gazete/%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/resmi-gazete\.php[\s?] [NC]
    RewriteRule ^ /resmi-gazete? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/kose-yazisi\.php\?y=([^\s&]+) [NC]
    RewriteRule ^ /valentra-diyor-ki/%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/kose-yazilari\.php\?sayfa=([0-9]+) [NC]
    RewriteRule ^ /valentra-diyor-ki?sayfa=%1 [R=301,L]

    RewriteCond %{THE_REQUEST} \s/kose-yazilari\.php[\s?] [NC]
    RewriteRule ^ /valentra-diyor-ki? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/araclar\.php[\s?] [NC]
    RewriteRule ^ /araclar? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/rehberler\.php[\s?] [NC]
    RewriteRule ^ /rehberler? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/rehber\.php\?r=([^\s&]+) [NC]
    RewriteRule ^ /rehber/%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/kurumsal\.php\?s=(hakkimizda|yayin-ilkeleri|kunye|iletisim|gizlilik)[\s&] [NC]
    RewriteRule ^ /%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
    RewriteRule ^ /? [R=301,L]

    # --- Temiz adres -> gercek dosya (ic yonlendirme) ----------------
    #
    # QSA: sayfa numarasi gibi eklenen parametreler korunur.
    # Gercekten var olan bir dosya ya da dizin istenmisse hicbir sey
    # yapilmiyor; /assets, /admin ve /api oldugu gibi calismaya devam
    # ediyor.

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^haber/([^/]+)/?$ haber.php?h=$1 [L,QSA]

    # Kurumsal sayfalar (26.10.2026)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(hakkimizda|yayin-ilkeleri|kunye|iletisim|gizlilik)/?$ kurumsal.php?s=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^kategori/([^/]+)/?$ kategori.php?k=$1 [L,QSA]

    # Video haberler (30.10.2026)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^video/?$ video.php [L,QSA]

    # Valentra Network ve uyelik (31.10.2026): /network, /uye/giris, /uye/kayit, /uye/cikis
    RewriteRule ^network/?$ network.php [L,QSA]
    # V Network alt sayfalari (31.10.2026): /network/h/12, /network/u/3, /network/mesajlar ...
    RewriteRule ^network/([a-z0-9/]+?)/?$ network.php?yol=$1 [L,QSA]
    RewriteRule ^uye/(giris|kayit|cikis)/?$ uye.php?islem=$1 [L,QSA]
    # Sifremi unuttum, sifre yenileme, e-posta dogrulamasi (31.10.2026)
    RewriteRule ^uye/(sifre|yenile|dogrula)/?$ uye-eposta.php?islem=$1 [L,QSA]

    # ValPapel, ValSpor, ValMagazin (29.10.2026): /valpapel, /valpapel/doviz
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(valpapel|valspor|valmagazin)(?:/([a-z0-9-]+))?/?$ gazete.php?g=$1&b=$2 [L,QSA]

    # Etiket sayfalari (28.10.2026)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^etiket/([^/]+)/?$ etiket.php?e=$1 [L,QSA,B]

    # Piyasalar (Ekonomi menusu, 22.10.2026)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^piyasalar/?$ piyasalar.php [L,QSA]

    # Sirket sayfasi: /sirket (liste), /sirket/THYAO
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^sirket/?$ sirket.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^sirket/([A-Za-z0-9]+)/?$ sirket.php?kod=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^kanun/([^/]+)/?$ kanun.php?k=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^kanunlar/?$ kanunlar.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^pratik-bilgiler/?$ pratik-bilgiler.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^araclar/?$ araclar.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ara/?$ ara.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^rehberler/?$ rehberler.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^rehber/([^/]+)/?$ rehber.php?r=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^vergi-takvimi/?$ vergi-takvimi.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^pratik/([^/]+)/?$ pratik-bilgi.php?p=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^resmi-gazete/?$ resmi-gazete.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^resmi-gazete/([0-9]{4}-[0-9]{2}-[0-9]{2})/?$ resmi-gazete.php?tarih=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^valentra-diyor-ki/?$ kose-yazilari.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^valentra-diyor-ki/([^/]+)/?$ kose-yazisi.php?y=$1 [L,QSA]

    # Kose yazari sayfasi (23.10.2026): /yazar/ahmet-sami-gumus
    RewriteRule ^yazar/([a-z0-9-]+)/?$ yazar.php?y=$1 [L,QSA]

    # Gunluk burc yorumlari (29.10.2026): /burclar ve /burc/koc
    RewriteRule ^burclar/?$ burclar.php [L,QSA]
    RewriteRule ^burc/([a-z]+)/?$ burc.php?b=$1 [L,QSA]
</IfModule>

# --- Statik dosyalarin tarayici onbellegi (29.10.2026) ----------------
#
# Lighthouse "verimli onbellek politikasi" uyarisi: stil, betik, logo ve
# simgeler her ziyarette yeniden soruluyordu. CSS/JS varlik() ile ?s=
# surumlu baglaniyor (degisince adres degisir), bir yil guvenli. Surumsuz
# baglanan logo ve simgeler bir hafta. Haber gorselleri kendi klasorunde
# (gorseller/haber/.htaccess). IfModule: modul yoksa site dusmesin.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|gif|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    # Haber ve yazar gorselleri (gorseller/*): dosya adi kaynak adresin
    # ozeti, icerik degismiyor; bir yil. Klasordeki .htaccess'in ayni
    # yonergesi sunucuda (LiteSpeed) uygulanmiyordu, 30.10.2026 olcumunde
    # bu gorseller bir haftalik geliyordu (Lighthouse "uzun onbellek").
    <FilesMatch "^[0-9a-f]{40}(-\d+)?\.(webp|jpe?g|png|gif|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
