# Apache, Authorization basligini varsayilan olarak PHP'ye gecirmez.
# Bearer dogrulamasinin calismasi icin acikca aktariyoruz.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # PHP2Shell gecici onlemi (bkz. kokteki .htaccess): API dosya
    # almiyor, multipart istek PHP'ye ulasmadan reddediliyor.
    RewriteCond %{HTTP:Content-Type} multipart/ [NC]
    RewriteRule ^ - [F]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>
