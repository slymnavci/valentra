# Deploy sirasinda GitHub Secrets'tan uretilir, asla repoya girmez.
includes/database.php

# Yerel gelistirme
includes/database.local.php
*.log
.DS_Store

# Ajan bagimliliklari (GitHub Actions'ta kurulur)
ajan/vendor/
ajan/composer.lock

# Sunucuda guncellenen kok sertifika listesi; depoya girmez.
includes/sertifika/ca-bundle-guncel.crt

# Panelden yuklenen kanun PDF'leri; depoya girmez.
includes/kanun_pdf/
ajan/onbellek/

# Egitim platformunun icerigi (dersler, soru bankasi) ve materyalleri
# sunucuda duruyor; uyelere ozel oldugu icin herkese acik depoya girmez.
# Aktarim: panel -> Egitim.
egitim/content/
egitim/materyaller/

# Ajanin siteye gonderemedigi haberler (GitHub eserine yuklenir)
ajan/teslim/

# Kaynaklardan indirilen haber gorselleri (gorsel.php); sunucuda duruyor.
gorseller/haber/*
!gorseller/haber/.htaccess
!gorseller/haber/index.html

# Kose yazari fotograflari (ajan uretip yukluyor); sunucuda duruyor.
gorseller/yazar/*
!gorseller/yazar/.htaccess
!gorseller/yazar/index.html

# Sayfa onbellegi (includes/sayfa_onbellek.php); sunucuda uretilir.
onbellek/sayfa/*
!onbellek/sayfa/index.html
